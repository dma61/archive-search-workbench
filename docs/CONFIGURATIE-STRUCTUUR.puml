@startuml
title Archive Search Workbench - deployment & ports (generic)\nWho runs where, and which ports connect them

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam nodeFontSize 13

actor "User" as USER

node "Client machine (OPTIONAL, only for network-USB)" as DESK #line.dashed {
  component "Browser\n(the app UI)" as BROWSER
  component "Per-machine agent\n:5060 (token-auth)\n/disks /read-file /bind /unbind" as AGENT
  component "USB/IP exporter\n(shares USB via :3240)\nusbipd-win / usbip" as USBIPD
  card "External archive drives\n(read-only intended)" as DISKS
  DISKS --> AGENT : read locally
  DISKS --> USBIPD : share (USB/IP)
}

node "App host (any machine: laptop, server, or NAS)" as SERVER {
  component "web_app.py (Flask :5059)\nsearch - manage - /api/remote/*" as APP
  database "SQLite catalog\n(metadata, searchable offline)" as DB
  component "Recoll full-text index" as RECOLL
  component "USB/IP importer\nusbip_ctl.sh + vhci-hcd" as USBIP
  component "Read-only mount\nmount_readonly.sh" as MNT
  APP --> DB
  APP --> RECOLL
  APP --> USBIP
  USBIP --> MNT
}

USER --> BROWSER
BROWSER --> APP : HTTP :5059
APP --> AGENT : /disks /read-file (token) [read file locally]
USBIP <--> USBIPD : USB/IP :3240 [drive as /dev/sdX; for indexing]

note bottom of SERVER
  Base case: run the app host and plug drives in directly -
  no client machine needed. The client machine above is only
  for the OPTIONAL network-USB mode.
  Ports: 5059 web, 5060 agent, 3240 usbip.
end note

note right of DISKS
  Read-only toward external media (core principle).
  Identification by filesystem UUID (volume labels are not unique).
end note
@enduml
